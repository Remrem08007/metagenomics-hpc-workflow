params {
    input         = null
    outdir        = 'results'
    host_index    = null
    kraken2_db    = null
    kaiju_db      = null
    kaiju_fmi     = null
    container_dir = null

    fastp_min_length                = 35
    fastp_qualified_quality_phred   = 15
    fastp_unqualified_percent_limit = 40
    fastp_cut_mean_quality          = 20

    star_multimap_max        = 100
    star_anchor_multimap_max = 200
    star_mismatch_ratio_max  = 0.10
    star_score_min_over_read = 0.50
    star_match_min_over_read = 0.50

    max_star_unmapped_pct = -1
    max_kraken_human_pct  = -1
    human_taxid           = 9606
    kaiju_expand_viruses  = true
}

manifest {
    name = 'Remrem08007/metagenomics-hpc-workflow'
    author = 'Rémi-Antoine Joron'
    homePage = 'https://github.com/Remrem08007/metagenomics-hpc-workflow'
    description = 'Host depletion and complementary Kraken2/Kaiju taxonomic profiling for paired-end sequencing on HPC.'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version = '0.2.0'
}

includeConfig 'conf/base.config'

profiles {
    local {
        includeConfig 'conf/local.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    singularity {
        includeConfig 'conf/singularity.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
    test {
        includeConfig 'conf/test.config'
    }
}
