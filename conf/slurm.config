process {
    executor = 'slurm'
    resourceLimits = [
        cpus: 64,
        memory: 512.GB,
        time: 72.h
    ]
}

executor {
    queueSize = 40
    pollInterval = '30 sec'
    submitRateLimit = '10/1min'
}

// Intentionally no account/partition is hard-coded.
// Add site-specific settings with -c, for example:
//   process.queue = 'compute'
//   process.clusterOptions = '--account=my_allocation'
